@echo off
chcp 65001 >nul

REM ============================================================
REM 汽车售后维修服务管理平台 - Docker 一键停止 (Windows)
REM ============================================================

set "PROJECT_ROOT=%~dp0"
cd /d "%PROJECT_ROOT%"

echo.
echo ============================================================
echo     停止所有服务
echo ============================================================
echo.

docker compose down
if %errorlevel% equ 0 (
    echo.
    echo [√] 所有服务已停止
) else (
    echo.
    echo [警告] 停止时出现问题，请检查 Docker 是否正在运行
)

echo.
echo ============================================================
echo     提示: 如需清除数据库数据，请执行:
echo     docker compose down -v
echo ============================================================
echo.
pause
